# dependencies and build output
node_modules/
dist/
macos/build/

# personal data (the app keeps real data in ~/Library/Application Support/BrainBook)
data/
*.local.json
.env
.env.*

# macOS / editors
.DS_Store
.vscode/
.idea/
*.log
macos/.sign-identity
__pycache__/
*.pyc
.playwright-cli/
# evidence/ is mostly one run's leftovers (server.log, server.pid, captures from older rounds), so it
# stays out of the tree — except the captures an acceptance criterion is judged from. A capture that is
# ignored is a file no review of the change can open, so the proof was unreachable however many times it
# was regenerated; that is why each measured surface keeps its own captures here.
evidence/*
!evidence/team-sheet-*.png
!evidence/control-center-*.png
# …and the numbers behind those captures. A fit claimed in prose is a claim about a layout nobody can
# re-check; the measurement file carries the popup height, its cap, the headroom and each region's
# overflow for every card at every viewport, so a review reads the fit instead of taking it on trust.
!evidence/team-sheet-*.json
!evidence/control-center-*.json
# …and the manifest each run writes before its first check, which is what ties a capture to the source
# that produced it. Absent = never measured here, `running` = a run that did not finish, `complete`
# with a matching fingerprint = the only state that describes a picture.
!evidence/team-sheet-*.md
!evidence/control-center-*.md
inputs/

# runtime scratch for local dev/test runs (dev-server logs, pids, throwaway BRAINBOOK_HOME copies
# of the real app home). Lives inside the repo so a run never has to write outside the workspace —
# that is what killed the first attempt at this card: its log went to /tmp, the command was refused,
# and the whole verification never ran.
.run/

# Vite dependency pre-bundle cache (regenerated automatically; not source)
.vite-stage/
.vite-test/


# 214MB Node runtime bundled into the .app by the Xcode build. Too large for GitHub
# (100MB limit) and was purged from history 2026-10-17; keep it local-only.
macos/node-self-contained
