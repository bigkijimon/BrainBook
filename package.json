{
  "name": "brainbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "node scripts/sync-theme-palette.mjs && node scripts/sync-loading.mjs && node scripts/check-harness-build.mjs && vite build",
    "start": "node server.mjs",
    "smoke": "node server.mjs --smoke",
    "test:criteria": "node --test tests/jev-decisions.test.mjs tests/worker-router.test.mjs tests/next-work.test.mjs tests/live-work.test.mjs tests/idea-card.test.mjs tests/idea-score.test.mjs tests/theme-palette.test.mjs",
    "test:log": "node scripts/test-server-log.mjs",
    "test:metrics": "node scripts/test-product-metrics.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:control-center": "node scripts/test-control-center.mjs",
    "test:voice": "node scripts/test-voice.mjs",
    "test:team-sheet": "node scripts/test-team-sheet-fit.mjs",
    "verify:popup": "npm run test:team-sheet && npm run test:voice",
    "check:ts-scope": "node scripts/check-ts-scope.mjs",
    "check:harness": "node scripts/check-harness-build.mjs",
    "check:release": "node scripts/check-release-info.mjs"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@fontsource/yellowtail": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.171.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "1.61.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
